<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging policy for a PII-owning service.
  - Correlation/trace ids come from MDC (populated by RequestContextFilter).
  - NEVER interpolate raw domain objects into log lines: entities/DTOs carrying
    name/email/DOB must be masked via MaskingUtils before logging. This config
    only controls transport/format; PII avoidance is enforced in code.
  - local/dev: human-readable console. prod: single-line, ready for a JSON
    collector (swap in logstash-logback-encoder if structured JSON is required).
-->
<configuration scan="false">

    <property name="LOG_PATTERN_CONSOLE"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC} %-5level [%thread] [corr=%X{correlationId:-} trace=%X{traceId:-}] %logger{36} - %msg%n"/>
    <property name="LOG_PATTERN_PROD"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC} %-5level svc=user-service corr=%X{correlationId:-} trace=%X{traceId:-} logger=%logger{40} msg=%msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN_CONSOLE}</pattern>
        </encoder>
    </appender>

    <appender name="CONSOLE_PROD" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN_PROD}</pattern>
        </encoder>
    </appender>

    <springProfile name="local,dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <root level="WARN">
            <appender-ref ref="CONSOLE_PROD"/>
        </root>
    </springProfile>

    <!-- Fallback when no profile is set (e.g. tests). -->
    <springProfile name="!local &amp; !dev &amp; !prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
