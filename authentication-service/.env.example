# ---- Server ----
SERVER_PORT=8081

# ---- Database (Postgres) ----
DB_URL=jdbc:postgresql://localhost:5432/authdb
DB_USERNAME=auth
DB_PASSWORD=change-me

# ---- Kafka ----
KAFKA_BOOTSTRAP=localhost:9092

# ---- JWT (RS256) ----
# Base64 body of PKCS#8 private key and X.509 public key (PEM headers optional).
# Generate with the commands in README (openssl). If left blank an EPHEMERAL dev key is used.
JWT_ISSUER=https://auth.paymentprocessor.local
JWT_AUDIENCE=payment-platform
JWT_KEY_ID=auth-key-1
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=PT15M
REFRESH_TTL=P30D

# ---- Security policy ----
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW=PT15M
LOCKOUT_DURATION=PT15M
RL_LOGIN_PER_MIN=10
